{
  "name": "pensive-unified",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run web:dev --",
    "build": "npm run web:build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:deployments": "convex deployments",
    "convex:codegen": "convex codegen",
    "convex:typecheck": "tsc -p convex/tsconfig.json",
    "convex:compatibility": "node scripts/convex-compatibility.mjs",
    "convex:backfill-original-amount-currency": "node scripts/migrations/001_original_amount_currency.mjs",
    "convex:schema-checkpoint": "node scripts/convex-schema-checkpoint.mjs",
    "convex:staging-compatibility": "node scripts/convex-staging-compatibility.mjs",
    "dev:db:list-users": "node scripts/dev-db-seed.mjs --list-users",
    "dev:db:seed": "node scripts/dev-db-seed.mjs",
    "test": "npm run test:unit && npm run test:convex",
    "test:unit": "vitest run --config tests/vitest.config.ts tests/web tests/scripts",
    "test:convex": "vitest run --config tests/vitest.config.ts tests/convex",
    "test:coverage": "vitest run --config tests/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:static": "npm run format:check && npm run lint && npm run convex:typecheck && npm run test:types && npm run web:build",
    "test:all": "npm run test:static && npm test && npm run test:e2e && npm run ios:test",
    "web:dev": "vite --config \"Codebase - Pensive Web/config/vite.config.ts\"",
    "web:build": "tsc --noEmit -p \"Codebase - Pensive Web/config/tsconfig.app.json\" && tsc --noEmit -p \"Codebase - Pensive Web/config/tsconfig.node.json\" && vite build --config \"Codebase - Pensive Web/config/vite.config.ts\"",
    "web:preview": "vite preview --config \"Codebase - Pensive Web/config/vite.config.ts\"",
    "ios:test": "./scripts/test-ios-stable.sh",
    "lint": "eslint --config \"Codebase - Pensive Web/eslint.config.js\" \"Codebase - Pensive Web\"",
    "format": "prettier --ignore-path \"Codebase - Pensive Web/config/.prettierignore\" --cache --write \"Codebase - Pensive Web/src/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"Codebase - Pensive Web/config/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"Codebase - Pensive Web/{vite.config.ts,eslint.config.js}\" \"convex/*.ts\" \"tests/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "format:check": "prettier --ignore-path \"Codebase - Pensive Web/config/.prettierignore\" --check \"Codebase - Pensive Web/src/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"Codebase - Pensive Web/config/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"Codebase - Pensive Web/{vite.config.ts,eslint.config.js}\" \"convex/*.ts\" \"tests/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\""
  },
  "prettier": {
    "plugins": [
      "./Codebase - Pensive Web/config/prettier-one-line-imports.mjs",
      "./Codebase - Pensive Web/config/prettier-one-line-props.mjs"
    ],
    "singleLineImports": true,
    "sortTopImportsByLength": true,
    "singleLineFunctionParamDestructuring": true,
    "overrides": [
      {
        "files": [
          "**/*.{js,jsx,cjs,mjs}"
        ],
        "options": {
          "parser": "imports-babel"
        }
      },
      {
        "files": [
          "**/*.{ts,tsx,cts,mts}"
        ],
        "options": {
          "parser": "imports-typescript"
        }
      }
    ]
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.0",
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "@internationalized/date": "^3.12.2",
    "csv-parse": "^6.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "convex": "^1.39.1",
    "convex-test": "^0.0.55",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.9.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
